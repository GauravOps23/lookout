# Local development without PostgreSQL. Copy to ".env" in this folder (backend\.env); the app reads it automatically.
DATABASE_URL=sqlite:///./dev.db
# Generate with:  python -m app.cli gen-master-key   (keep it: losing it makes stored credentials unreadable)
MASTER_KEY=
# http://localhost only. Leave out (default true) behind HTTPS.
COOKIE_SECURE=false
